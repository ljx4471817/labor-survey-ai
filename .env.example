# 知识库构建 · 环境变量模板
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不提交。

# ============ Embedding 提供方 ============
# 可选: bge | dashscope
EMBEDDING_PROVIDER=dashscope

# BGE（智源开放平台）
# 申请：https://modelbest.feishu.cn/share/open_api
BGE_API_KEY=
BGE_MODEL=BAAI/bge-large-zh-v1.5
BGE_API_URL=https://api.bge.modelbest.cn/v1/embeddings

# DashScope（阿里云百炼）
# 申请：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=text-embedding-v3

# ============ LLM（对话生成）============
# 可选: deepseek | dashscope
LLM_PROVIDER=deepseek

# DeepSeek
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# DashScope（备选）
DASHSCOPE_LLM_MODEL=qwen-plus

# ============ Chroma 持久化 ============
CHROMA_DIR=backend/data/chroma
CHROMA_COLLECTION=labor_survey_qa

# ============ 检索参数 ============
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ============ 讯飞实时语音转写大模型 ============
